{
  "name": "@forge-ops/tracker-react-native",
  "version": "0.18.0",
  "description": "ForgeOps error tracking client for React Native apps: captures uncaught JS exceptions (ErrorUtils) and unhandled promise rejections, plus explicit capture anywhere else, and delivers them to ForgeOps over HTTP.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "ForgeOps",
  "homepage": "https://getforgeops.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luke-Popwell/forge-ops-tracker-react-native.git"
  },
  "files": [
    "dist",
    "LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "peerDependencies": {
    "react-native": ">=0.70"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
